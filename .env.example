PORT=3001
HOST=127.0.0.1
YTDLP_PATH=yt-dlp
GALLERYDL_PATH=gallery-dl
# Optional: Python environment containing yt-dlp; otherwise inferred from YTDLP_PATH
PYTHON_PATH=
FFMPEG_PATH=ffmpeg
MAX_MEDIA_MB=200
REQUEST_TIMEOUT_MS=120000
SESSION_TTL_MS=900000
MAX_CONCURRENT_JOBS=3

# Netlify: set this in Netlify build environment to your backend HTTPS origin
VITE_API_ORIGIN=
# Backend: exact frontend origin(s), comma-separated; no trailing slash
FRONTEND_ORIGINS=
